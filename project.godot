; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pete's AC Adventure"
config/description="Help Pete deliver cool air in this fun endless runner! Earn real discounts on AC service by playing."
run/main_scene="res://scenes/runner/TempleRunMain.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"
config/version="0.2.0"

[autoload]

GameManager="*res://scenes/managers/GameManager.gd"
SaveManager="*res://scripts/managers/SaveManager.gd"
RunnerAudio="*res://scripts/audio/runner_audio.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/min_width=360
window/size/min_height=640
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor]

start_scene="res://scenes/runner/TempleRunMain.tscn"
editor_plugins=PackedStringArray()

[export]

file_section_1/ext="pkg"
file_section_1/path="export/release/petes-ac-adventure.ipa"
file_section_1/remote_filenames="release:/petes-ac-adventure.ipa"
file_section_2/ext="apk"
file_section_2/path="export/release/petes-ac-adventure.apk"
file_section_2/remote_filenames="release:/petes-ac-adventure.apk"

[export_options]

export_filters=PackedStringArray()
export_options=PackedStringArray()

